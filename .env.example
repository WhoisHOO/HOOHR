# HOOHR environment template
# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# ---- required ----

# PostgreSQL connection string.
# With `docker compose up -d db` the defaults below match the compose service.
DATABASE_URL="postgresql://hr:hoohr_dev_password@localhost:5432/hoohr"

# Session cookie signing key. The app throws at startup if this is unset.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---- bootstrap admin (used by `npm run db:seed`) ----

BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD=""

# ---- public base URL ----
# Used to build invite links. Point this at your tunnel/domain in production.
APP_URL="http://localhost:3000"

# ---- SMTP (NOT-1 decision + invite mail, NOT-2 approval digest) ----
# Leave SMTP_HOST empty to disable all mail. The app is fully functional without
# it: approval notices and the invite digest become no-ops, and invite links are
# still shown on screen for the admin to copy.
# For local testing, run any SMTP sink and point SMTP_HOST at it, e.g.
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=""
SMTP_PORT="587"
# Optional. A credential-less relay (Mailpit, MailHog, a local Postfix) needs
# neither, and auth is only attached when both USER and PASS are set.
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="hr@app.local"
# Optional. Leave unset to derive it: true for port 465, false elsewhere.
# SMTP_SECURE="false"

# ---- docker compose ----

POSTGRES_USER="hr"
POSTGRES_PASSWORD="hoohr_dev_password"
POSTGRES_DB="hoohr"
POSTGRES_PORT="5432"
APP_PORT="3000"
